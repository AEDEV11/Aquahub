# Copy to .env.staging.local after an isolated Supabase staging project exists.
# The staging build rejects the production Supabase project reference.
VITE_SUPABASE_ENV=staging
VITE_SUPABASE_URL=https://replace-with-staging-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
VITE_GOOGLE_MAPS_BROWSER_KEY=replace-with-staging-referrer-restricted-browser-key
