rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /owner-media/{ownerUid}/stations/{stationId}/{category}/{fileName} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == ownerUid
        && category in ['products', 'station', 'payment-qr-gcash', 'payment-qr-maya']
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];

      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }
  }
}
