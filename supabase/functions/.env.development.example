# Inert local-only template. Copy to .env.development.local for functions serve.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY come from the local Supabase stack.
GOOGLE_MAPS_SERVER_API_KEY=replace-with-development-server-only-key
GUEST_ORDER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEWSLETTER_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
NEWSLETTER_RATE_LIMIT_HMAC_KEY=replace-with-random-development-secret
NEWSLETTER_CONSENT_POLICY_VERSION=2026-10-v1
HOSTINGER_REACH_API_TOKEN=replace-with-development-reach-api-token
HOSTINGER_REACH_PROFILE_UUID=replace-with-reach-profile-uuid
HOSTINGER_REACH_ENABLED=false
HOSTINGER_REACH_DOUBLE_OPT_IN=true
MARKETING_DISPATCH_SECRET=replace-with-random-development-dispatch-secret
