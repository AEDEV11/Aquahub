# Inert template. Copy to .env.staging.local for local staging-function testing,
# or use its approved values through Supabase's secret store after authorization.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by the Supabase runtime.
GOOGLE_MAPS_SERVER_API_KEY=replace-with-staging-server-only-key
GUEST_ORDER_ALLOWED_ORIGINS=https://replace-with-exact-staging-preview-origin
NEWSLETTER_ALLOWED_ORIGINS=https://replace-with-exact-staging-site-origin
NEWSLETTER_RATE_LIMIT_HMAC_KEY=replace-with-random-staging-secret
NEWSLETTER_CONSENT_POLICY_VERSION=2026-10-v1
HOSTINGER_REACH_API_TOKEN=replace-with-staging-reach-api-token
HOSTINGER_REACH_PROFILE_UUID=replace-with-staging-reach-profile-uuid
HOSTINGER_REACH_ENABLED=false
HOSTINGER_REACH_DOUBLE_OPT_IN=true
MARKETING_DISPATCH_SECRET=replace-with-random-staging-dispatch-secret
# Dedicated Google OIDC identities; never put the Supabase service-role key in
# a Scheduler/Pub/Sub Authorization header.
PLAY_RTDN_PUSH_AUDIENCE=https://replace-with-staging-project.supabase.co/functions/v1/play-rtdn
PLAY_RTDN_PUSH_SERVICE_ACCOUNT=pubsub-push@replace-with-staging-project.iam.gserviceaccount.com
PLAY_RECONCILIATION_PUSH_AUDIENCE=https://replace-with-staging-project.supabase.co/functions/v1/reconcile-play-subscriptions
PLAY_RECONCILIATION_PUSH_SERVICE_ACCOUNT=scheduler@replace-with-staging-project.iam.gserviceaccount.com
